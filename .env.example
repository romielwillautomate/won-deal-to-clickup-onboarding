# Shared secret. Any long random string. The CRM sends it in the X-Webhook-Secret header,
# or as the custom data key webhook_secret (GoHighLevel's Webhook action). Empty refuses everything.
WEBHOOK_SECRET=make-up-a-long-random-string

# ClickUp (avatar → Settings → Apps → API Token). Personal tokens start with pk_ and are sent without "Bearer".
CLICKUP_API_TOKEN=pk_your_clickup_token
# The first number after app.clickup.com/ in any ClickUp link
CLICKUP_WORKSPACE_ID=9012345
# Where the onboarding lists go: a space (lists without a folder) or a folder. The folder wins when both are set.
CLICKUP_SPACE_ID=90150001
CLICKUP_FOLDER_ID=
# The list template id, starts with t- (GET /api/v2/team/{workspace_id}/list_template)
CLICKUP_TEMPLATE_ID=t-90160001
# Optional: custom field names in the template (defaults shown)
CLICKUP_FIELD_PACKAGE=Package
CLICKUP_FIELD_START_DATE=Start Date
CLICKUP_FIELD_DEAL_VALUE=Deal Value
# Optional: how long to wait for ClickUp to apply the template (ms), and how long to let it finish after a timeout (s)
CLICKUP_TEMPLATE_TIMEOUT_MS=90000
CLICKUP_TEMPLATE_WAIT_SECONDS=30

# Kickoff tasks, one line of JSON in single quotes (Docker Compose removes them; if your setup keeps them, the workflow does).
# offset_days = business days from the start date.
# assignees = ClickUp user ids (GET /api/v2/team). in_email = list the step in the welcome email.
KICKOFF_TASKS_JSON='[{"name":"Send welcome packet","offset_days":-1,"assignees":[111111],"priority":3},{"name":"Kickoff call","offset_days":0,"assignees":[111111,222222],"priority":2,"in_email":true,"email_label":"Kickoff call with your account team"},{"name":"Collect logins and brand assets","offset_days":2,"assignees":[222222],"in_email":true,"email_label":"Share your logins and brand assets"},{"name":"Set up CRM pipeline","offset_days":4,"assignees":[222222]},{"name":"Week 1 check-in","offset_days":5,"assignees":[111111],"in_email":true,"email_label":"Week 1 check-in call"}]'

# Optional: dates, money and the email
BUSINESS_TIMEZONE=America/New_York
DEFAULT_START_BUSINESS_DAYS=5
DEFAULT_CURRENCY=USD
BUSINESS_NAME=Acme Growth
KICKOFF_BOOKING_URL=https://calendar.example.com/acme/kickoff

# Postmark (Servers → your server → API Tokens). POSTMARK_FROM must be a confirmed Sender Signature.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM=Acme Growth <onboarding@acmegrowth.example.com>
# Optional
POSTMARK_REPLY_TO=success@acmegrowth.example.com
POSTMARK_MESSAGE_STREAM=outbound

# Slack incoming webhook for onboarding updates (the error alert workflow uses it too)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
